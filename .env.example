# Copy to .env.local (same folder). .env.local is git-ignored and is the only place secrets belong.
# Every line is optional: with an empty file the console runs on loopback with an in-memory store,
# an in-process queue, scripted sandbox scenarios and the lexical mock embedding.

# ---- Sandbox: real models -------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-4o

# ---- Server -----------------------------------------------------------------------------------
# PORT=4319
# HOST=127.0.0.1                 # anything other than loopback REQUIRES ADMIRALTY_API_KEY
# ADMIRALTY_API_KEY=             # when set, every /api route and /events needs "Authorization: Bearer <key>" or "x-api-key"
# WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# ADMIRALTY_DATA_DIR=apps/server/data   # policy.json, audit.jsonl, collectors.json
# ADMIRALTY_TAMPER_DEMO=0        # disable the "Simulate tamper" button
# ADMIRALTY_DEMO=0               # disable the "Load demo scenario" button

# ---- Storage and queues (docker compose --env-file .env.local up -d) ----------------------------
# POSTGRES_PASSWORD=change-me    # required by docker-compose.yml
# POSTGRES_USER=admiralty
# POSTGRES_DB=admiralty
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# DATABASE_URL=postgres://admiralty:change-me@127.0.0.1:5432/admiralty   # PostgreSQL with PostGIS + pgvector
# REDIS_URL=redis://127.0.0.1:6379                                        # BullMQ

# ---- Embeddings ---------------------------------------------------------------------------------
# EMBEDDING_PROVIDER=local       # local (default: transformers.js, downloads the model once) | http | mock
# EMBEDDING_MODEL=Xenova/multilingual-e5-small   # local: a multilingual model; http: the model name sent to the endpoint
# EMBEDDING_CACHE_DIR=           # where the local model files are kept
# EMBEDDING_API_URL=             # http: an OpenAI-compatible /v1/embeddings URL
# EMBEDDING_API_KEY=

# ---- Geolocation --------------------------------------------------------------------------------
# MAXMIND_CITY_DB_PATH=/data/GeoLite2-City.mmdb
# MAXMIND_ASN_DB_PATH=/data/GeoLite2-ASN.mmdb
# GEOIP_CSV=/data/geoip.csv      # cidr,lat,lon[,label]; takes precedence over MaxMind
# GEONAMES_TSV_PATH=/data/cities15000.txt
# GEONAMES_MIN_POPULATION=15000
# NOMINATIM_URL=                 # e.g. your own Nominatim; used only for explicit place claims, cached in the store
# NOMINATIM_MIN_INTERVAL_MS=1100

# ---- Fraud rings --------------------------------------------------------------------------------
# LEDGER_WEBHOOK_SECRET=         # enables POST /api/ingest/ledger (HMAC-SHA256)
# RING_WINDOW_HOURS=168          # only ledger events this recent are considered
# RING_PROXIMITY_KM=             # also link different accounts at the same place and time (PostGIS ST_DWithin)
# RING_PROXIMITY_WINDOW_MIN=10

# ---- Live Telegram collector (GramJS / MTProto) -------------------------------------------------
# TELEGRAM_API_ID=               # from my.telegram.org
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=              # create with: npm run telegram:login -w @admiralty-gate/server
# TELEGRAM_CHANNELS=channel_one:D3,channel_two   # public channel usernames, each with an optional Admiralty grade (default F6)
# TELEGRAM_POLL_SECONDS=15

# ---- Dashboard ----------------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4319
# Street-level base map (vector tiles from OpenFreeMap). The map falls back to the bundled country outlines
# when this URL cannot be reached. Comment it out to never contact a tile server.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
