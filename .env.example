# Copy to .env.local (same folder). .env.local is git-ignored. Both keys are optional:
# without them the playground runs its scripted red-team scenarios.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Fusion workbench (all optional) ----
# Without DATABASE_URL the server keeps provenance in memory; without REDIS_URL it queues jobs in-process.
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://admiralty:change-me@127.0.0.1:5432/admiralty
# REDIS_URL=redis://127.0.0.1:6379
# LEDGER_WEBHOOK_SECRET=            # enables POST /api/ingest/ledger (HMAC-SHA256)
# GEOIP_CSV=/path/geoip.csv         # cidr,lat,lon[,label] rows for offline IP geolocation
# ADMIRALTY_DEMO=0                  # disable the "Load demo scenario" button
# NEXT_PUBLIC_MAP_STYLE_URL=        # a MapLibre style URL, to use real map tiles instead of the bundled outlines

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-4o
# PORT=4319                      # API port
# HOST=127.0.0.1                 # keep on loopback: the API has no login
# WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# ADMIRALTY_DATA_DIR=apps/server/data   # policy.json and audit.jsonl
# ADMIRALTY_TAMPER_DEMO=0        # disable the "Simulate tamper" button
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4319
