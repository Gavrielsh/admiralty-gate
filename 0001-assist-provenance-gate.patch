+/**
+ * OSIRIS OI Assist: a provenance gate between the model and the tools that
+ * act on people or hosts.
+ *
+ * The assistant reads text it did not write (news headlines, Telegram posts,
+ * results of earlier lookups) and, in the same context, can call `recon`:
+ * username hunts, phone and email-breach lookups, scanner-backed probes. A
+ * hostile headline can therefore try to steer those calls. Prompts that call
+ * the text "material, never instructions" lower the odds; this file makes the
+ * outcome independent of the odds. The same principle already guards
+ * `forecast` (it starts only when the reader asks for one); this extends it to
+ * the lookups that touch other people's data.
+ *
+ * Rule: untrusted text may inform an answer but never authorise a lookup.
+ *   - what the reader typed is trusted;
+ *   - everything else (tool results, feed text, the model's own words) is not;
+ *   - a person or probe lookup runs only if its target appears in the
+ *     reader's own messages;
+ *   - an infra lookup is refused when its target appears only in untrusted text.
+ *
+ * A refused call comes back to the model and the reader as a normal failed
+ * action whose message says what to do: put the target in your own message.
+ * No new UI, no new dependencies, no server change.
+ *
+ * What it does not do: it does not stop the model saying false things, and
+ * tracing is lexical (a target the model re-encodes or paraphrases matches no
+ * span, which counts as "not typed by the reader" for person and probe
+ * lookups).
+ */
+import type { AssistMessage, Call } from './protocol';
+import type { Outcome } from './tools';
+import { reconToolId, type ReconTool } from './recon';
+
+/* ───────────── Text normalisation: see what the model sees ───────────── */
+
+const INVISIBLE = /[­͏؜ᅟᅠ឴឵᠋-᠏​-‏‪-‮⁠-⁯ㅤ︀-️﻿ﾠ]/g;
+const TAG_CHARS = /[\u{E0000}-\u{E007F}]/gu;
+
+/**
+ * Lower-cased, NFKC text without zero-width and bidi controls or combining
+ * marks (Hebrew niqqud, Arabic harakat). Unicode "tag" characters are decoded
+ * to the ASCII they encode, because a model reads them.
+ */
+export function normalise(raw: string): string {
+  return raw
+    .replace(TAG_CHARS, ch => {
+      const cp = ch.codePointAt(0) ?? 0;
+      return cp >= 0xe0020 && cp <= 0xe007e ? String.fromCharCode(cp - 0xe0000) : '';
+    })
+    .replace(INVISIBLE, '')
+    .normalize('NFKD')
+    .replace(/\p{M}+/gu, '')
+    .toLowerCase()
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+/** Word tokens over any script; trailing punctuation is not part of a token. */
+export function tokens(raw: string): string[] {
+  const found = normalise(raw).match(/[\p{L}\p{N}][\p{L}\p{N}_.@:/?#=&%+~-]*/gu) ?? [];
+  return found.map(t => t.replace(/[.:/?#=&%+~_-]+$/u, '')).filter(Boolean);
+}
+
+const hostsOf = (toks: string[]): string[] =>
+  toks.flatMap(t => {
+    const m = /^[a-z][a-z0-9+.-]*:\/\/(?:[^/@]*@)?([^/:?#]+)/u.exec(t);
+    return m?.[1] ? [m[1]] : [];
+  });
+
+function containsRun(hay: string[], needle: string[]): boolean {
+  if (!needle.length || needle.length > hay.length) return false;
+  outer: for (let i = 0; i + needle.length <= hay.length; i++) {
+    for (let j = 0; j < needle.length; j++) if (hay[i + j] !== needle[j]) continue outer;
+    return true;
+  }
+  return false;
+}
+
+/* ───────────── Provenance ───────────── */
+
+export type Source = 'reader' | 'untrusted' | 'unknown';
+
+interface Span { tokens: string[]; hosts: Set<string>; reader: boolean }
+
+export class Provenance {
+  private readonly spans: Span[] = [];
+
+  private add(text: string, reader: boolean): void {
+    const toks = tokens(text);
+    if (toks.length) this.spans.push({ tokens: toks, hosts: new Set(hostsOf(toks)), reader });
+  }
+
+  /** Text the reader typed. */
+  fromReader(text: string): void { this.add(text, true); }
+  /** Anything else: feed text, tool results, the model's own words. */
+  fromElsewhere(text: string): void { this.add(text, false); }
+
+  /**
+   * Where a value came from, by whole-token match (so "ample.com" cannot borrow
+   * trust from a reader who typed "example.com"). Appearing in a reader span
+   * wins: the reader said it independently of whatever else repeats it.
+   */
+  trace(value: unknown): Source {
+    const need = tokens(typeof value === 'string' ? value : typeof value === 'number' ? String(value) : '');
+    if (!need.length) return 'unknown';
+    let seen = false;
+    for (const s of this.spans) {
+      const hit = containsRun(s.tokens, need) || (need.length === 1 && s.hosts.has(need[0] as string));
+      if (!hit) continue;
+      if (s.reader) return 'reader';
+      seen = true;
+    }
+    return seen ? 'untrusted' : 'unknown';
+  }
+}
+
+/** Rebuild provenance from a conversation: the reader's turns are trusted, all else is not. */
+export function provenanceOf(history: AssistMessage[], said: string): Provenance {
+  const p = new Provenance();
+  for (const m of history) {
+    if (m.role === 'user') p.fromReader(m.text);
+    else if (m.role === 'assistant') p.fromElsewhere(m.say);
+    else for (const r of m.results) p.fromElsewhere(`${r.summary} ${safeJson(r.data)}`);
+  }
+  p.fromReader(said);
+  return p;
+}
+
+const safeJson = (v: unknown): string => {
+  try { return v === undefined ? '' : JSON.stringify(v); } catch { return ''; }
+};
+
+/* ───────────── Tiers and verdicts ───────────── */
+
+export type Tier = 'view' | 'infra' | 'person' | 'probe';
+
+const INFRA: ReadonlySet<ReconTool> = new Set(['shodan', 'dns', 'whois', 'certs', 'bgp', 'mac', 'threats', 'crypto']);
+const PERSON: ReadonlySet<ReconTool> = new Set(['username', 'phone', 'github', 'leaks']);
+
+/** Tier of a call. Aliases resolve through recon.ts, so "breach" is a person lookup like "leaks". Unknown recon names fail closed. */
+export function tierOf(call: Call): Tier {
+  if (call.tool !== 'recon') return 'view';
+  const a = call.args;
+  const id = reconToolId(typeof (a.tool ?? a.name ?? a.type) === 'string' ? String(a.tool ?? a.name ?? a.type) : '');
+  if (id === 'self_track') return 'view';
+  if (id && INFRA.has(id)) return 'infra';
+  if (id && PERSON.has(id)) return 'person';
+  return 'probe';
+}
+
+/** The argument names tools.ts reads a recon target from. All are checked, not just the one used first. */
+const TARGET_KEYS = ['target', 'query', 'ip', 'domain', 'address', 'number', 'user', 'email', 'host'] as const;
+
+export type Verdict = { ok: true } | { ok: false; summary: string };
+
+export function judge(call: Call, prov: Provenance): Verdict {
+  const tier = tierOf(call);
+  if (tier === 'view') return { ok: true };
+  for (const k of TARGET_KEYS) {
+    const v = call.args[k];
+    if (v === undefined || v === null || v === '') continue;
+    const src = prov.trace(v);
+    if (src === 'reader') continue;
+    if (tier === 'infra' && src === 'unknown') continue;
+    const where = src === 'untrusted' ? 'appears only in feed text or earlier results' : 'was not typed by you';
+    const what = tier === 'person' ? 'a lookup about a person' : tier === 'probe' ? 'an active probe' : 'a lookup';
+    return {
+      ok: false,
+      summary: `Not run: ${what} needs a target you typed yourself, and this one ${where}. Put it in your own message to run it.`,
+    };
+  }
+  return { ok: true };
+}
+
+/* ───────────── Wiring ───────────── */
+
+export type Exec = (call: Call, signal?: AbortSignal) => Promise<Outcome>;
+
+/**
+ * Wrap the assistant's `exec`. Each result it returns is recorded as untrusted
+ * before the model reads it, so later arguments lifted from it are traced as such.
+ */
+export function gateExec(prov: Provenance, exec: Exec): Exec {
+  return async (call, signal) => {
+    const v = judge(call, prov);
+    if (!v.ok) return { result: { tool: call.tool, ok: false, summary: v.summary } };
+    const out = await exec(call, signal);
+    prov.fromElsewhere(`${out.result.summary} ${safeJson(out.result.data)}`);
+    return out;
+  };
+}
