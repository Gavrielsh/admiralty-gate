{
  "name": "@admiralty-gate/server",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "admiralty-gate-mcp-bridge": "dist/mcp-bridge.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "telegram:login": "tsx src/collectors/telegram-login.ts",
    "fetch:test-data": "node scripts/fetch-test-data.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@fastify/cors": "latest",
    "@maxmind/geoip2-node": "^7.1.0",
    "admiralty-gate": "*",
    "bullmq": "^5.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "telegram": "^2.26.22"
  }
}
